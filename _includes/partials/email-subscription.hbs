<form class="gh-form" action="#" method="post" novalidate>
  <input
    id="{{#if email_field_id}}{{email_field_id}}{{else}}email{{/if}}"
    class="gh-form-input"
    type="email"
    name="email"
    placeholder="jamie@example.com"
    aria-label="Email"
  >
  <button class="gh-button" type="submit">Subscribe</button>
</form>
